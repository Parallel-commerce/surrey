{{ 'section-bento-box.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-article-card.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient isolate">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <div class="title-wrapper">
        <h2 class="bento-box-title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.heading }}
        </h2>
      </div>
    {%- endif -%}

    <div class="bento-box-grid">
      {% assign skip_card_product_styles = false %}
      {%- for block in section.blocks -%}
        {%- liquid
          assign size_class = 'bento-item--1x1'
          if block.settings.size == 'full'
            assign size_class = 'bento-item--4x4'
          elsif block.settings.size == 'tall'
            assign size_class = 'bento-item--1x2'
          elsif block.settings.size == 'medium'
            assign size_class = 'bento-item--2x2'
          endif
        -%}
        <div
          class="bento-item {{ size_class }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {{ block.shopify_attributes }}
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
            style="--animation-order: {{ forloop.index }};"
          {% endif %}
        >
          {%- case block.type -%}
            {%- when 'image' -%}
              <div class="bento-image-card">
                {%- if block.settings.image != blank -%}
                  {%- liquid
                    assign focal_point = block.settings.image.presentation.focal_point
                    if focal_point == blank
                      assign focal_point = 'center center'
                    endif
                  -%}
                  <div class="bento-image-wrapper">
                    <div class="bento-image-media">
                      <img
                        srcset="
                          {%- if block.settings.image.width >= 375 -%}{{ block.settings.image | image_url: width: 375 }} 375w,{%- endif -%}
                          {%- if block.settings.image.width >= 750 -%}{{ block.settings.image | image_url: width: 750 }} 750w,{%- endif -%}
                          {%- if block.settings.image.width >= 1100 -%}{{ block.settings.image | image_url: width: 1100 }} 1100w,{%- endif -%}
                          {%- if block.settings.image.width >= 1500 -%}{{ block.settings.image | image_url: width: 1500 }} 1500w,{%- endif -%}
                          {%- if block.settings.image.width >= 2000 -%}{{ block.settings.image | image_url: width: 2000 }} 2000w,{%- endif -%}
                          {{ block.settings.image | image_url }} {{ block.settings.image.width }}w
                        "
                        src="{{ block.settings.image | image_url: width: 1500 }}"
                        sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 4 }}px, (min-width: 750px) calc((100vw - 100px) / 4), calc(100vw - 30px)"
                        alt="{{ block.settings.image.alt | escape }}"
                        loading="lazy"
                        width="{{ block.settings.image.width }}"
                        height="{{ block.settings.image.height }}"
                        class="bento-image"
                        style="object-position: {{ focal_point }};"
                      >
                    </div>
                    {%- if block.settings.title != blank or block.settings.subtitle != blank -%}
                      <div class="bento-image-overlay">
                        <div class="bento-image-content">
                          {%- if block.settings.subtitle != blank -%}
                            <p class="bento-image-subtitle">{{ block.settings.subtitle }}</p>
                          {%- endif -%}
                          {%- if block.settings.title != blank -%}
                            <h3 class="bento-image-title {{ block.settings.title_size }}">
                              {{ block.settings.title }}
                            </h3>
                          {%- endif -%}
                          {%- if block.settings.link != blank -%}
                            <a
                              href="{{ block.settings.link }}"
                              class="bento-image-link full-unstyled-link"
                              aria-label="{{ block.settings.title | escape }}"
                            >
                              <span class="visually-hidden">{{ block.settings.title | escape }}</span>
                            </a>
                          {%- endif -%}
                        </div>
                      </div>
                    {%- endif -%}
                  </div>
                {%- else -%}
                  <div class="bento-image-wrapper">
                    <div class="bento-image-media">
                      {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  </div>
                {%- endif -%}
              </div>

            {%- when 'product' -%}
              {%- liquid
                assign product = block.settings.product
                if product != blank and product.featured_media
                  assign focal_point = product.featured_media.presentation.focal_point
                  if focal_point == blank
                    assign focal_point = 'center center'
                  endif
                endif
              -%}
              <div class="bento-image-card">
                {%- if product != blank and product.featured_media -%}
                  <div class="bento-image-wrapper">
                    <div class="bento-image-media">
                      <img
                        srcset="
                          {%- if product.featured_media.width >= 375 -%}{{ product.featured_media | image_url: width: 375 }} 375w,{%- endif -%}
                          {%- if product.featured_media.width >= 750 -%}{{ product.featured_media | image_url: width: 750 }} 750w,{%- endif -%}
                          {%- if product.featured_media.width >= 1100 -%}{{ product.featured_media | image_url: width: 1100 }} 1100w,{%- endif -%}
                          {%- if product.featured_media.width >= 1500 -%}{{ product.featured_media | image_url: width: 1500 }} 1500w,{%- endif -%}
                          {%- if product.featured_media.width >= 2000 -%}{{ product.featured_media | image_url: width: 2000 }} 2000w,{%- endif -%}
                          {{ product.featured_media | image_url }} {{ product.featured_media.width }}w
                        "
                        src="{{ product.featured_media | image_url: width: 1500 }}"
                        sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 4 }}px, (min-width: 750px) calc((100vw - 100px) / 4), calc(100vw - 30px)"
                        alt="{{ product.featured_media.alt | escape }}"
                        loading="lazy"
                        width="{{ product.featured_media.width }}"
                        height="{{ product.featured_media.height }}"
                        class="bento-image"
                        style="object-position: {{ focal_point }};"
                      >
                      {%- if block.settings.second_image and product.media[1] != null -%}
                        <img
                          srcset="
                            {%- if product.media[1].width >= 375 -%}{{ product.media[1] | image_url: width: 375 }} 375w,{%- endif -%}
                            {%- if product.media[1].width >= 750 -%}{{ product.media[1] | image_url: width: 750 }} 750w,{%- endif -%}
                            {%- if product.media[1].width >= 1100 -%}{{ product.media[1] | image_url: width: 1100 }} 1100w,{%- endif -%}
                            {%- if product.media[1].width >= 1500 -%}{{ product.media[1] | image_url: width: 1500 }} 1500w,{%- endif -%}
                            {{ product.media[1] | image_url }} {{ product.media[1].width }}w
                          "
                          src="{{ product.media[1] | image_url: width: 1500 }}"
                          sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 4 }}px, (min-width: 750px) calc((100vw - 100px) / 4), calc(100vw - 30px)"
                          alt="{{ product.media[1].alt | escape }}"
                          loading="lazy"
                          width="{{ product.media[1].width }}"
                          height="{{ product.media[1].height }}"
                          class="bento-image bento-image--secondary"
                          style="object-position: {{ focal_point }};"
                        >
                      {%- endif -%}
                    </div>
                    <div class="bento-image-overlay">
                      <div class="bento-image-content">
                        <h3 class="bento-image-title h2">{{ product.title | escape }}</h3>
                        {% render 'price', product: product, price_class: 'bento-price', show_compare_at_price: true %}
                        <a
                          href="{{ product.url }}"
                          class="bento-image-link full-unstyled-link"
                          aria-label="{{ product.title | escape }}"
                        >
                          <span class="visually-hidden">{{ product.title | escape }}</span>
                        </a>
                      </div>
                    </div>
                  </div>
                {%- else -%}
                  {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
                  {%- assign placeholder_image = 'product-apparel-' | append: placeholder_image_index -%}
                  <div class="bento-image-wrapper">
                    <div class="bento-image-media">
                      {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                    <div class="bento-image-overlay">
                      <div class="bento-image-content">
                        <h3 class="bento-image-title h2">{{ 'onboarding.product_title' | t }}</h3>
                        {% render 'price', placeholder: true, price_class: 'bento-price' %}
                      </div>
                    </div>
                  </div>
                {%- endif -%}
              </div>

            {%- when 'collection' -%}
              {%- liquid
                assign collection = block.settings.collection
                if collection != blank and collection.featured_image
                  assign focal_point = collection.featured_image.presentation.focal_point
                  if focal_point == blank
                    assign focal_point = 'center center'
                  endif
                endif
              -%}
              <div class="bento-image-card">
                {%- if collection != blank and collection.featured_image -%}
                  <div class="bento-image-wrapper">
                    <div class="bento-image-media">
                      <img
                        srcset="
                          {%- if collection.featured_image.width >= 375 -%}{{ collection.featured_image | image_url: width: 375 }} 375w,{%- endif -%}
                          {%- if collection.featured_image.width >= 750 -%}{{ collection.featured_image | image_url: width: 750 }} 750w,{%- endif -%}
                          {%- if collection.featured_image.width >= 1100 -%}{{ collection.featured_image | image_url: width: 1100 }} 1100w,{%- endif -%}
                          {%- if collection.featured_image.width >= 1500 -%}{{ collection.featured_image | image_url: width: 1500 }} 1500w,{%- endif -%}
                          {%- if collection.featured_image.width >= 2000 -%}{{ collection.featured_image | image_url: width: 2000 }} 2000w,{%- endif -%}
                          {{ collection.featured_image | image_url }} {{ collection.featured_image.width }}w
                        "
                        src="{{ collection.featured_image | image_url: width: 1500 }}"
                        sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 4 }}px, (min-width: 750px) calc((100vw - 100px) / 4), calc(100vw - 30px)"
                        alt="{{ collection.featured_image.alt | escape }}"
                        loading="lazy"
                        width="{{ collection.featured_image.width }}"
                        height="{{ collection.featured_image.height }}"
                        class="bento-image"
                        style="object-position: {{ focal_point }};"
                      >
                    </div>
                    <div class="bento-image-overlay">
                      <div class="bento-image-content">
                        <h3 class="bento-image-title h2">{{ collection.title | escape }}</h3>
                        {%- if collection.description != blank -%}
                          <p class="bento-image-subtitle">
                            {{ collection.description | strip_html | truncatewords: 15 }}
                          </p>
                        {%- endif -%}
                        <a
                          href="{{ collection.url }}"
                          class="bento-image-link full-unstyled-link"
                          aria-label="{{ collection.title | escape }}"
                        >
                          <span class="visually-hidden">{{ collection.title | escape }}</span>
                        </a>
                      </div>
                    </div>
                  </div>
                {%- else -%}
                  {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
                  {%- assign placeholder_image = 'collection-apparel-' | append: placeholder_image_index -%}
                  <div class="bento-image-wrapper">
                    <div class="bento-image-media">
                      {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                    <div class="bento-image-overlay">
                      <div class="bento-image-content">
                        <h3 class="bento-image-title h2">{{ 'onboarding.collection_title' | t }}</h3>
                      </div>
                    </div>
                  </div>
                {%- endif -%}
              </div>

            {%- when 'article' -%}
              {%- if block.settings.article != blank -%}
                {%- liquid
                  assign article = block.settings.article
                  assign ratio = 1.66
                  if article.image
                    assign ratio = article.image.aspect_ratio
                  endif
                -%}
                <div class="article-card-wrapper card-wrapper">
                  <div class="card article-card card--{{ settings.blog_card_style }}{% if settings.blog_card_style == 'card' %} color-{{ settings.blog_card_color_scheme }} gradient{% endif %} card--media">
                    <div
                      class="card__inner {% if settings.blog_card_style == 'standard' %}color-{{ settings.blog_card_color_scheme }} gradient{% endif %} ratio"
                      style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;"
                    >
                      {%- if article.image -%}
                        <div class="article-card__image-wrapper card__media">
                          <div class="article-card__image media media--hover-effect">
                            <img
                              srcset="
                                {%- if article.image.src.width >= 165 -%}{{ article.image.src | image_url: width: 165 }} 165w,{%- endif -%}
                                {%- if article.image.src.width >= 360 -%}{{ article.image.src | image_url: width: 360 }} 360w,{%- endif -%}
                                {%- if article.image.src.width >= 533 -%}{{ article.image.src | image_url: width: 533 }} 533w,{%- endif -%}
                                {%- if article.image.src.width >= 720 -%}{{ article.image.src | image_url: width: 720 }} 720w,{%- endif -%}
                                {%- if article.image.src.width >= 1000 -%}{{ article.image.src | image_url: width: 1000 }} 1000w,{%- endif -%}
                                {%- if article.image.src.width >= 1500 -%}{{ article.image.src | image_url: width: 1500 }} 1500w,{%- endif -%}
                                {{ article.image.src | image_url }} {{ article.image.src.width }}w
                              "
                              src="{{ article.image.src | image_url: width: 533 }}"
                              sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 4 }}px, (min-width: 750px) calc((100vw - 100px) / 4), calc(100vw - 30px)"
                              alt="{{ article.image.src.alt | escape }}"
                              loading="lazy"
                              width="{{ article.image.width }}"
                              height="{{ article.image.height }}"
                              class="motion-reduce"
                            >
                          </div>
                        </div>
                      {%- endif -%}
                      <div class="card__content">
                        <div class="card__information">
                          <h3 class="card__heading{% if block.settings.show_excerpt %} h2{% endif %}">
                            <a href="{{ article.url }}" class="full-unstyled-link">
                              {{ article.title | truncate: 50 | escape }}
                            </a>
                          </h3>
                          <div class="article-card__info caption-with-letter-spacing h5">
                            {%- if block.settings.show_date -%}
                              <span class="circle-divider">{{ article.published_at | time_tag: format: 'date' }}</span>
                            {%- endif -%}
                            {%- if block.settings.show_author -%}
                              <span>{{ article.author }}</span>
                            {%- endif -%}
                          </div>
                          {%- if block.settings.show_excerpt -%}
                            {%- if article.excerpt.size > 0 or article.content.size > 0 -%}
                              <p class="article-card__excerpt rte-width">
                                {%- if article.excerpt.size > 0 -%}
                                  {{ article.excerpt | strip_html | truncatewords: 30 }}
                                {%- else -%}
                                  {{ article.content | strip_html | truncatewords: 30 }}
                                {%- endif -%}
                              </p>
                            {%- endif -%}
                          {%- endif -%}
                        </div>
                      </div>
                    </div>
                    <div class="card__content">
                      <div class="card__information">
                        <h3 class="card__heading{% if block.settings.show_excerpt %} h2{% endif %}">
                          <a href="{{ article.url }}" class="full-unstyled-link">
                            {{ article.title | truncate: 50 | escape }}
                          </a>
                        </h3>
                        <div class="article-card__info caption-with-letter-spacing h5">
                          {%- if block.settings.show_date -%}
                            <span class="circle-divider">{{ article.published_at | time_tag: format: 'date' }}</span>
                          {%- endif -%}
                          {%- if block.settings.show_author -%}
                            <span>{{ article.author }}</span>
                          {%- endif -%}
                        </div>
                        {%- if block.settings.show_excerpt -%}
                          {%- if article.excerpt.size > 0 or article.content.size > 0 -%}
                            <p class="article-card__excerpt rte-width">
                              {%- if article.excerpt.size > 0 -%}
                                {{ article.excerpt | strip_html | truncatewords: 30 }}
                              {%- else -%}
                                {{ article.content | strip_html | truncatewords: 30 }}
                              {%- endif -%}
                            </p>
                          {%- endif -%}
                        {%- endif -%}
                      </div>
                    </div>
                  </div>
                </div>
              {%- else -%}
                {%- assign placeholder_image_index = forloop.index0 | modulo: 3 | plus: 1 -%}
                {%- assign placeholder_image = 'blog-apparel-' | append: placeholder_image_index -%}
                <div class="article-card-wrapper card-wrapper">
                  <div class="card article-card card--{{ settings.blog_card_style }}{% if settings.blog_card_style == 'card' %} color-{{ settings.blog_card_color_scheme }} gradient{% endif %} card--media">
                    <div
                      class="card__inner {% if settings.blog_card_style == 'standard' %}color-{{ settings.blog_card_color_scheme }} gradient{% endif %} ratio"
                      style="--ratio-percent: 60.24%;"
                    >
                      <div class="article-card__image-wrapper card__media">
                        <div class="article-card__image media">
                          {{ placeholder_image | placeholder_svg_tag: 'blog-placeholder-svg' }}
                        </div>
                      </div>
                      <div class="card__content">
                        <div class="card__information">
                          <h3 class="card__heading h2">
                            {{ 'sections.featured_blog.onboarding_title' | t }}
                          </h3>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              {%- endif -%}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bento Box",
  "tag": "section",
  "class": "section section-bento-box",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Bento Box"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image with Overlay",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Image Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Image Subtitle"
        },
        {
          "type": "select",
          "id": "title_size",
          "options": [
            {
              "value": "h3",
              "label": "Small"
            },
            {
              "value": "h2",
              "label": "Medium"
            },
            {
              "value": "h1",
              "label": "Large"
            }
          ],
          "default": "h2",
          "label": "Title size"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        },
        {
          "type": "select",
          "id": "size",
          "options": [
            {
              "value": "small",
              "label": "Small (1x1)"
            },
            {
              "value": "medium",
              "label": "Medium (2x2)"
            },
            {
              "value": "tall",
              "label": "Tall (1x2)"
            },
            {
              "value": "full",
              "label": "Full (4x4)"
            }
          ],
          "default": "small",
          "label": "Item size"
        }
      ]
    },
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "checkbox",
          "id": "second_image",
          "default": false,
          "label": "Show second image on hover"
        },
        {
          "type": "select",
          "id": "size",
          "options": [
            {
              "value": "small",
              "label": "Small (1x1)"
            },
            {
              "value": "medium",
              "label": "Medium (2x2)"
            },
            {
              "value": "tall",
              "label": "Tall (1x2)"
            },
            {
              "value": "full",
              "label": "Full (4x4)"
            }
          ],
          "default": "small",
          "label": "Item size"
        }
      ]
    },
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "select",
          "id": "size",
          "options": [
            {
              "value": "small",
              "label": "Small (1x1)"
            },
            {
              "value": "medium",
              "label": "Medium (2x2)"
            },
            {
              "value": "tall",
              "label": "Tall (1x2)"
            },
            {
              "value": "full",
              "label": "Full (4x4)"
            }
          ],
          "default": "small",
          "label": "Item size"
        }
      ]
    },
    {
      "type": "article",
      "name": "Blog Post",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Article"
        },
        {
          "type": "checkbox",
          "id": "show_date",
          "default": true,
          "label": "Show date"
        },
        {
          "type": "checkbox",
          "id": "show_author",
          "default": false,
          "label": "Show author"
        },
        {
          "type": "checkbox",
          "id": "show_excerpt",
          "default": true,
          "label": "Show excerpt"
        },
        {
          "type": "select",
          "id": "size",
