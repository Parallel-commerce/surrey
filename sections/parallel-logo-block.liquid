{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign block_count = section.blocks.size
  if block_count > 8
    assign block_count = 8
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .logo-block-{{ section.id }} {
    width: 100%;
  }

  .logo-block-{{ section.id }}__container {
    max-width: 100%;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media screen and (min-width: 750px) {
    .logo-block-{{ section.id }}__container {
      padding: 0 5rem;
    }
  }

  .logo-block-{{ section.id }}__grid {
    display: grid;
    {%- if section.settings.mobile_columns == '2' -%}
      grid-template-columns: repeat(2, minmax(0, 1fr));
    {%- else -%}
      grid-template-columns: repeat(1, minmax(0, 1fr));
    {%- endif -%}
    gap: 2rem;
    align-items: center;
    justify-items: center;
  }

  @media screen and (min-width: 750px) {
    .logo-block-{{ section.id }}__grid {
      grid-template-columns: repeat({{ block_count }}, minmax(0, 1fr));
      gap: {{ section.settings.logo_spacing }}px;
    }
  }

  .logo-block-{{ section.id }}__item {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .logo-block-{{ section.id }}__item img {
    max-width: {{ section.settings.logo_width }}px;
    width: 100%;
    height: auto;
    object-fit: contain;
    opacity: {{ section.settings.logo_opacity | divided_by: 100.0 }};
    transition: opacity 0.3s ease;
  }

  {%- if section.settings.logo_hover_opacity > 0 -%}
    .logo-block-{{ section.id }}__item:hover img {
      opacity: {{ section.settings.logo_hover_opacity | divided_by: 100.0 }};
    }
  {%- endif -%}

  .logo-block-{{ section.id }}__item a {
    display: block;
    width: 100%;
    text-decoration: none;
  }

  .logo-block-{{ section.id }}__title {
    text-align: {{ section.settings.title_alignment }};
    margin-bottom: {{ section.settings.title_spacing }}px;
  }

  .logo-block-{{ section.id }}__title h2 {
    margin: 0;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="logo-block-{{ section.id }} section-{{ section.id }}-padding isolate">
    <div class="logo-block-{{ section.id }}__container">
      {%- if section.settings.title != blank -%}
        <div class="logo-block-{{ section.id }}__title{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          <h2 class="inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.title }}
          </h2>
        </div>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="logo-block-{{ section.id }}__grid">
          {%- for block in section.blocks -%}
            {%- if block.settings.logo != blank -%}
              {%- liquid
                assign logo_alt = block.settings.alt_text
                if logo_alt == blank
                  assign logo_alt = 'Logo'
                endif
                assign logo_sizes = '(min-width: 750px) ' | append: section.settings.logo_width | append: 'px, 100vw'
              -%}
              <div
                class="logo-block-{{ section.id }}__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {%- if block.settings.link != blank -%}
                  <a
                    href="{{ block.settings.link }}"
                    {% if block.settings.link_target_blank %}
                      target="_blank" rel="noopener noreferrer"
                    {% endif %}
                  >
                {%- endif -%}
                {{
                  block.settings.logo
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', alt: logo_alt, sizes: logo_sizes, widths: '200, 300, 400, 500, 600'
                }}
                {%- if block.settings.link != blank -%}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Logo Block",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "Our Partners"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        },
        {
          "value": "hxl",
          "label": "Extra large"
        },
        {
          "value": "hxxl",
          "label": "Extra extra large"
        }
      ],
      "default": "h1",
      "label": "Title size"
    },
    {
      "type": "select",
      "id": "title_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Title alignment"
    },
    {
      "type": "range",
      "id": "title_spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Title spacing",
      "default": 24,
      "info": "Space between title and logos"
    },
    {
      "type": "header",
      "content": "Logo Settings"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 150,
      "info": "Maximum width for each logo"
    },
    {
      "type": "range",
      "id": "logo_spacing",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Logo spacing (desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Logo opacity",
      "default": 100
    },
    {
      "type": "range",
      "id": "logo_hover_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Logo hover opacity",
      "default": 100,
      "info": "Set to 0 to disable hover effect"
    },
    {
      "type": "header",
      "content": "Mobile Settings"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "1",
      "label": "Mobile columns",
      "info": "Logos will stack in the selected number of columns on mobile"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text",
          "default": "Logo",
          "info": "Description of the logo for accessibility"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional link for the logo"
        },
        {
          "type": "checkbox",
          "id": "link_target_blank",
          "label": "Open link in new tab",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Logo Block",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        }
      ]
    }
  ]
}
{% endschema %}
