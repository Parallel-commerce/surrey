{{ 'section-product-highlights.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient isolate">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <div class="title-wrapper{% if section.settings.heading_alignment == 'center' %} center{% endif %}">
        <h2 class="product-highlights__heading inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.heading }}
        </h2>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul
        class="product-highlights__grid product-highlights__grid--{{ section.settings.columns_desktop }}-col"
        role="list"
      >
        {%- for block in section.blocks -%}
          <li
            class="product-highlights__item product-highlights__item--{{ section.settings.layout }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            {%- if section.settings.layout == 'horizontal' -%}
              {%- if block.settings.custom_icon != blank -%}
                <div class="product-highlights__icon product-highlights__icon--{{ section.settings.icon_shape }}">
                  <img
                    src="{{ block.settings.custom_icon | image_url: width: 96 }}"
                    alt="{{ block.settings.custom_icon.alt | default: block.settings.heading | escape }}"
                    width="48"
                    height="48"
                    loading="lazy"
                  >
                </div>
              {%- elsif block.settings.icon != 'none' -%}
                <div class="product-highlights__icon product-highlights__icon--{{ section.settings.icon_shape }}">
                  {%- render 'icon-accordion', icon: block.settings.icon -%}
                </div>
              {%- endif -%}
              <div class="product-highlights__text">
                {%- if block.settings.heading != blank -%}
                  <h3 class="product-highlights__title h5">{{ block.settings.heading | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <p class="product-highlights__description">{{ block.settings.description | escape }}</p>
                {%- endif -%}
              </div>
            {%- else -%}
              {%- if block.settings.custom_icon != blank -%}
                <div class="product-highlights__icon product-highlights__icon--{{ section.settings.icon_shape }}">
                  <img
                    src="{{ block.settings.custom_icon | image_url: width: 96 }}"
                    alt="{{ block.settings.custom_icon.alt | default: block.settings.heading | escape }}"
                    width="48"
                    height="48"
                    loading="lazy"
                  >
                </div>
              {%- elsif block.settings.icon != 'none' -%}
                <div class="product-highlights__icon product-highlights__icon--{{ section.settings.icon_shape }}">
                  {%- render 'icon-accordion', icon: block.settings.icon -%}
                </div>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h3 class="product-highlights__title h5">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="product-highlights__description">{{ block.settings.description | escape }}</p>
              {%- endif -%}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

