{%- comment -%}
  GCM v2 Cookie Consent — self-contained snippet.
  Requires the gtag/dataLayer defaults block to be the first script in <head>.
  CSS tokens are adapted for Dawn-style RGB-triplet custom properties.
{%- endcomment -%}

<style>
  :root {
    --cc-bg:        rgb(var(--color-background, 255, 255, 255));
    --cc-text:      rgb(var(--color-foreground, 18, 18, 18));
    --cc-border:    rgba(var(--color-foreground, 18, 18, 18), 0.12);
    --cc-btn-bg:    rgb(var(--color-button, 18, 18, 18));
    --cc-btn-text:  rgb(var(--color-button-text, 255, 255, 255));
    --cc-font:      var(--font-body-family, sans-serif);
    --cc-z:         var(--layer-temporary, 20);
    --cc-radius:    4px;
    --cc-transition: 0.2s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    :root { --cc-transition: 0s; }
  }

  /* ── Banner ─────────────────────────────────────────────── */
  #cc-banner {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: calc(var(--cc-z) * 10);
    background: var(--cc-bg);
    border-top: 1px solid var(--cc-border);
    padding: 1.6rem 2rem;
    font-family: var(--cc-font);
    font-size: 1.4rem;
    color: var(--cc-text);
  }

  #cc-banner.cc-visible {
    display: block;
  }

  .cc-banner__inner {
    max-width: 96rem;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.2rem 2rem;
  }

  .cc-banner__text {
    flex: 1 1 28rem;
    line-height: 1.5;
  }

  .cc-banner__text a {
    color: inherit;
  }

  .cc-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    align-items: center;
  }

  /* ── Shared button styles ───────────────────────────────── */
  .cc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.4rem;
    padding: 0 1.6rem;
    border-radius: var(--cc-radius);
    font-family: var(--cc-font);
    font-size: 1.3rem;
    font-weight: 600;
    cursor: pointer;
    border: 1px solid transparent;
    transition: opacity var(--cc-transition);
    white-space: nowrap;
    text-decoration: none;
  }

  .cc-btn:hover { opacity: 0.8; }
  .cc-btn:focus-visible { outline: 2px solid var(--cc-btn-bg); outline-offset: 2px; }

  .cc-btn--primary {
    background: var(--cc-btn-bg);
    color: var(--cc-btn-text);
  }

  .cc-btn--secondary {
    background: transparent;
    color: var(--cc-text);
    border-color: var(--cc-border);
  }

  .cc-btn--ghost {
    background: transparent;
    color: var(--cc-text);
    border-color: transparent;
    padding: 0;
    min-height: unset;
    font-weight: 400;
    text-decoration: underline;
  }

  /* ── Modal overlay ──────────────────────────────────────── */
  #cc-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: calc(var(--cc-z) * 10 + 1);
    background: rgba(0, 0, 0, 0.45);
  }

  #cc-modal-overlay.cc-visible {
    display: block;
  }

  /* ── Preferences modal ──────────────────────────────────── */
  #cc-modal {
    display: none;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: calc(var(--cc-z) * 10 + 2);
    background: var(--cc-bg);
    color: var(--cc-text);
    font-family: var(--cc-font);
    font-size: 1.4rem;
    border: 1px solid var(--cc-border);
    border-radius: var(--cc-radius);
    width: min(56rem, calc(100vw - 3.2rem));
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    padding: 2.4rem;
  }

  #cc-modal.cc-visible {
    display: block;
  }

  .cc-modal__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.2rem;
    margin-bottom: 1.6rem;
  }

  .cc-modal__title {
    font-size: 1.8rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.3;
  }

  .cc-modal__close {
    flex-shrink: 0;
    width: 4.4rem;
    height: 4.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border: none;
    background: transparent;
    font-size: 2rem;
    color: var(--cc-text);
    border-radius: var(--cc-radius);
    padding: 0;
  }

  .cc-modal__close:focus-visible { outline: 2px solid var(--cc-btn-bg); outline-offset: 2px; }

  .cc-modal__description {
    line-height: 1.6;
    margin-bottom: 2rem;
    opacity: 0.75;
  }

  /* ── Category rows ──────────────────────────────────────── */
  .cc-category {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.6rem;
    padding: 1.6rem 0;
    border-top: 1px solid var(--cc-border);
  }

  .cc-category__info {
    flex: 1;
  }

  .cc-category__name {
    font-weight: 600;
    margin-bottom: 0.4rem;
  }

  .cc-category__desc {
    font-size: 1.2rem;
    line-height: 1.5;
    opacity: 0.65;
  }

  /* ── Toggle switch ──────────────────────────────────────── */
  .cc-toggle {
    position: relative;
    flex-shrink: 0;
    width: 4.4rem;
    height: 2.6rem;
  }

  .cc-toggle input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .cc-toggle__track {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--cc-border);
    border-radius: 9999px;
    cursor: pointer;
    transition: background var(--cc-transition);
    position: relative;
  }

  .cc-toggle__track::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 2rem;
    height: 2rem;
    background: #fff;
    border-radius: 50%;
    transition: transform var(--cc-transition);
  }

  .cc-toggle input:checked + .cc-toggle__track {
    background: var(--cc-btn-bg);
  }

  .cc-toggle input:checked + .cc-toggle__track::after {
    transform: translateX(1.8rem);
  }

  .cc-toggle input:focus-visible + .cc-toggle__track {
    outline: 2px solid var(--cc-btn-bg);
    outline-offset: 2px;
  }

  .cc-toggle--locked .cc-toggle__track {
    cursor: default;
    opacity: 0.5;
  }

  /* ── Modal footer ───────────────────────────────────────── */
  .cc-modal__footer {
    display: flex;
    justify-content: flex-end;
    gap: 0.8rem;
    margin-top: 2rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--cc-border);
    flex-wrap: wrap;
  }

  /* ── Floating icon ──────────────────────────────────────── */
  #cc-icon {
    position: fixed;
    bottom: 2rem;
    left: 2rem;
    z-index: calc(var(--cc-z) * 10);
    width: 4.4rem;
    height: 4.4rem;
    border-radius: 50%;
    background: var(--cc-btn-bg);
    color: var(--cc-btn-text);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--cc-transition);
  }

  #cc-icon.cc-visible {
    opacity: 1;
    pointer-events: auto;
  }

  #cc-icon:focus-visible { outline: 2px solid var(--cc-btn-bg); outline-offset: 3px; }

  #cc-icon svg {
    width: 2rem;
    height: 2rem;
    fill: currentColor;
  }

  /* ── CCPA bar ───────────────────────────────────────────── */
  #cc-ccpa-bar {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: calc(var(--cc-z) * 10 - 1);
    background: var(--cc-bg);
    border-top: 1px solid var(--cc-border);
    padding: 1rem 2rem;
    font-family: var(--cc-font);
    font-size: 1.3rem;
    color: var(--cc-text);
    text-align: center;
  }

  #cc-ccpa-bar.cc-visible {
    display: block;
  }

  #cc-ccpa-bar a,
  #cc-ccpa-bar button {
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
    cursor: pointer;
    background: none;
    border: none;
    font-family: inherit;
    font-size: inherit;
    padding: 0;
  }
</style>

<!-- ── Cookie Consent Banner ──────────────────────────────────── -->
<div
  id="cc-banner"
  role="region"
  aria-label="Cookie consent"
  aria-live="polite"
>
  <div class="cc-banner__inner">
    <p class="cc-banner__text">
      We use cookies to improve your experience, serve personalised content, and analyse site traffic.
      By clicking "Accept all" you consent to our use of cookies.
      <a href="/policies/privacy-policy">Learn more</a>.
    </p>
    <div class="cc-banner__actions">
      <button id="cc-accept-all" class="cc-btn cc-btn--primary">Accept all</button>
      <button id="cc-reject-all" class="cc-btn cc-btn--secondary">Reject all</button>
      <button id="cc-open-prefs" class="cc-btn cc-btn--ghost">Manage preferences</button>
    </div>
  </div>
</div>

<!-- ── Preferences Modal ────────────────────────────────────────── -->
<div id="cc-modal-overlay" aria-hidden="true"></div>

<div
  id="cc-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cc-modal-title"
  tabindex="-1"
>
  <div class="cc-modal__header">
    <h2 id="cc-modal-title" class="cc-modal__title">Cookie preferences</h2>
    <button class="cc-modal__close" id="cc-modal-close" aria-label="Close cookie preferences">&times;</button>
  </div>

  <p class="cc-modal__description">
    Manage your cookie preferences below. Essential cookies are always active as they are required for the site to function.
    You can change your choices at any time by clicking the cookie icon in the bottom-left corner.
  </p>

  <div class="cc-category">
    <div class="cc-category__info">
      <div class="cc-category__name">Essential cookies</div>
      <div class="cc-category__desc">Required for the site to function (shopping cart, login, security). Cannot be disabled.</div>
    </div>
    <label class="cc-toggle cc-toggle--locked" aria-label="Essential cookies — always on">
      <input type="checkbox" checked disabled role="switch">
      <span class="cc-toggle__track"></span>
    </label>
  </div>

  <div class="cc-category">
    <div class="cc-category__info">
      <div class="cc-category__name">Analytics cookies</div>
      <div class="cc-category__desc">Help us understand how visitors interact with the site (e.g. Google Analytics). Data is aggregated and anonymous.</div>
    </div>
    <label class="cc-toggle" aria-label="Analytics cookies">
      <input type="checkbox" id="cc-toggle-analytics" role="switch">
      <span class="cc-toggle__track"></span>
    </label>
  </div>

  <div class="cc-category">
    <div class="cc-category__info">
      <div class="cc-category__name">Marketing cookies</div>
      <div class="cc-category__desc">Used to show you relevant ads on other sites and measure ad performance (e.g. Google Ads, Meta Pixel).</div>
    </div>
    <label class="cc-toggle" aria-label="Marketing cookies">
      <input type="checkbox" id="cc-toggle-marketing" role="switch">
      <span class="cc-toggle__track"></span>
    </label>
  </div>

  <div class="cc-category">
    <div class="cc-category__info">
      <div class="cc-category__name">Functional cookies</div>
      <div class="cc-category__desc">Enable enhanced features such as live chat, personalisation, and video content.</div>
    </div>
    <label class="cc-toggle" aria-label="Functional cookies">
      <input type="checkbox" id="cc-toggle-functional" role="switch">
      <span class="cc-toggle__track"></span>
    </label>
  </div>

  <div class="cc-modal__footer">
    <button id="cc-reject-all-modal" class="cc-btn cc-btn--secondary">Reject all</button>
    <button id="cc-save-prefs" class="cc-btn cc-btn--primary">Save preferences</button>
  </div>
</div>

<!-- ── Floating icon ─────────────────────────────────────────────── -->
<button id="cc-icon" aria-label="Cookie preferences">
  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10c0-.34-.02-.67-.05-1A3 3 0 0 1 17 7a3 3 0 0 1-3-3 3 3 0 0 1-.05-.3A9.87 9.87 0 0 0 12 2zm-1 14a1 1 0 1 1 2 0 1 1 0 0 1-2 0zm-3-4a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0zm6-3a1 1 0 1 1 2 0 1 1 0 0 1-2 0z"/>
  </svg>
</button>

<!-- ── CCPA bar ───────────────────────────────────────────────────── -->
<div id="cc-ccpa-bar">
  <span id="cc-ccpa-content">
    California resident?
    <button id="cc-ccpa-opt-out">Do Not Sell or Share My Personal Information</button>
  </span>
</div>

<script>
(function () {
  'use strict';

  var COOKIE_NAME = 'cc_consent';
  var COOKIE_DAYS = 180;

  // ── Cookie helpers ────────────────────────────────────────────
  function setCookie(name, value, days) {
    var expires = new Date();
    expires.setTime(expires.getTime() + days * 864e5);
    document.cookie = name + '=' + encodeURIComponent(JSON.stringify(value)) +
      '; expires=' + expires.toUTCString() +
      '; path=/; SameSite=Lax; Secure';
  }

  function getCookie(name) {
    var match = document.cookie.match('(?:^|;)\\s*' + name + '=([^;]*)');
    if (!match) return null;
    try { return JSON.parse(decodeURIComponent(match[1])); } catch (e) { return null; }
  }

  // ── GCM v2 update ────────────────────────────────────────────
  function updateGtag(prefs) {
    if (typeof gtag !== 'function') return;
    gtag('consent', 'update', {
      analytics_storage:       prefs.analytics  ? 'granted' : 'denied',
      ad_storage:              prefs.marketing  ? 'granted' : 'denied',
      ad_user_data:            prefs.marketing  ? 'granted' : 'denied',
      ad_personalization:      prefs.marketing  ? 'granted' : 'denied',
      functionality_storage:   prefs.functional ? 'granted' : 'denied',
      personalization_storage: prefs.functional ? 'granted' : 'denied'
    });
  }

  // ── Shopify Customer Privacy relay ───────────────────────────
  function updateShopifyPrivacy(prefs) {
    if (
      window.Shopify &&
      window.Shopify.customerPrivacy &&
      typeof window.Shopify.customerPrivacy.setTrackingConsent === 'function'
    ) {
      window.Shopify.customerPrivacy.setTrackingConsent({
        analytics:   prefs.analytics,
        marketing:   prefs.marketing,
        preferences: prefs.functional
      }, function () {});
    }
  }

  // ── dataLayer event ──────────────────────────────────────────
  function pushDataLayer(eventName, prefs) {
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: eventName, consent_preferences: prefs });
  }

  // ── Apply a consent choice ───────────────────────────────────
  function applyConsent(prefs) {
    setCookie(COOKIE_NAME, prefs, COOKIE_DAYS);
    updateGtag(prefs);
    updateShopifyPrivacy(prefs);
    pushDataLayer('consent_updated', prefs);
    hideBanner();
    closeModal();
    showIcon();
  }

  // ── UI helpers ───────────────────────────────────────────────
  function el(id) { return document.getElementById(id); }

  function showBanner() {
    var banner = el('cc-banner');
    if (banner) banner.classList.add('cc-visible');
  }

  function hideBanner() {
    var banner = el('cc-banner');
    if (banner) banner.classList.remove('cc-visible');
  }

  function showIcon() {
    var icon = el('cc-icon');
    if (icon) icon.classList.add('cc-visible');
  }

  function openModal() {
    var overlay = el('cc-modal-overlay');
    var modal   = el('cc-modal');
    if (overlay) { overlay.classList.add('cc-visible'); overlay.setAttribute('aria-hidden', 'false'); }
    if (modal)   { modal.classList.add('cc-visible'); modal.focus(); }
    document.addEventListener('keydown', handleModalKey);
  }

  function closeModal() {
    var overlay = el('cc-modal-overlay');
    var modal   = el('cc-modal');
    if (overlay) { overlay.classList.remove('cc-visible'); overlay.setAttribute('aria-hidden', 'true'); }
    if (modal)   modal.classList.remove('cc-visible');
    document.removeEventListener('keydown', handleModalKey);
  }

  // ── Focus trap & Escape key ───────────────────────────────────
  function handleModalKey(e) {
    var modal = el('cc-modal');
    if (!modal) return;
    if (e.key === 'Escape') { closeModal(); return; }
    if (e.key !== 'Tab') return;
    var focusable = Array.from(
      modal.querySelectorAll('button, [href], input:not([disabled]), [tabindex]:not([tabindex="-1"])')
    ).filter(function (n) { return !n.disabled && n.offsetParent !== null; });
    if (!focusable.length) return;
    var first = focusable[0];
    var last  = focusable[focusable.length - 1];
    if (e.shiftKey) {
      if (document.activeElement === first) { e.preventDefault(); last.focus(); }
    } else {
      if (document.activeElement === last)  { e.preventDefault(); first.focus(); }
    }
  }

  // ── Sync toggles to stored prefs ─────────────────────────────
  function syncToggles(prefs) {
    var aToggle = el('cc-toggle-analytics');
    var mToggle = el('cc-toggle-marketing');
    var fToggle = el('cc-toggle-functional');
    if (aToggle) aToggle.checked = !!prefs.analytics;
    if (mToggle) mToggle.checked = !!prefs.marketing;
    if (fToggle) fToggle.checked = !!prefs.functional;
  }

  function readToggles() {
    return {
      analytics:  !!(el('cc-toggle-analytics')  && el('cc-toggle-analytics').checked),
      marketing:  !!(el('cc-toggle-marketing')   && el('cc-toggle-marketing').checked),
      functional: !!(el('cc-toggle-functional')  && el('cc-toggle-functional').checked)
    };
  }

  // ── Wire up button events ─────────────────────────────────────
  function bindEvents() {
    var ALL_ON  = { analytics: true,  marketing: true,  functional: true  };
    var ALL_OFF = { analytics: false, marketing: false, functional: false };

    el('cc-accept-all').addEventListener('click', function () { applyConsent(ALL_ON); });
    el('cc-reject-all').addEventListener('click', function () { applyConsent(ALL_OFF); });

    el('cc-open-prefs').addEventListener('click', function () {
      var stored = getCookie(COOKIE_NAME) || ALL_OFF;
      syncToggles(stored);
      openModal();
    });

    el('cc-icon').addEventListener('click', function () {
      var stored = getCookie(COOKIE_NAME) || ALL_OFF;
      syncToggles(stored);
      openModal();
    });

    el('cc-modal-close').addEventListener('click', closeModal);
    el('cc-modal-overlay').addEventListener('click', closeModal);

    el('cc-reject-all-modal').addEventListener('click', function () { applyConsent(ALL_OFF); });

    el('cc-save-prefs').addEventListener('click', function () {
      applyConsent(readToggles());
    });

    // CCPA opt-out
    var ccpaBtn = el('cc-ccpa-opt-out');
    if (ccpaBtn) {
      ccpaBtn.addEventListener('click', function () {
        if (
          window.Shopify &&
          window.Shopify.customerPrivacy &&
          typeof window.Shopify.customerPrivacy.setTrackingConsent === 'function'
        ) {
          window.Shopify.customerPrivacy.setTrackingConsent({ sale_of_data: false }, function () {});
        }
        if (typeof gtag === 'function') {
          gtag('consent', 'update', {
            ad_storage:         'denied',
            ad_user_data:       'denied',
            ad_personalization: 'denied'
          });
        }
        pushDataLayer('ccpa_opt_out', {});
        var ccpaContent = el('cc-ccpa-content');
        if (ccpaContent) {
          ccpaContent.textContent = 'You have opted out of the sale or sharing of your personal information.';
        }
      });
    }
  }

  // ── Bootstrap — runs after Shopify Customer Privacy API loads ─
  function init() {
    bindEvents();

    var api = window.Shopify && window.Shopify.customerPrivacy;

    // Check Shopify's server-side consent record first (logged-in / returning customers)
    if (api && typeof api.currentVisitorConsent === 'function') {
      var serverConsent = api.currentVisitorConsent();
      var hasServerConsent = serverConsent &&
        (serverConsent.analytics === 'yes' || serverConsent.analytics === 'no') &&
        (serverConsent.marketing === 'yes' || serverConsent.marketing === 'no');

      if (hasServerConsent) {
        var prefs = {
          analytics:  serverConsent.analytics  === 'yes',
          marketing:  serverConsent.marketing   === 'yes',
          functional: serverConsent.preferences === 'yes'
        };
        // Restore silently — no banner
        setCookie(COOKIE_NAME, prefs, COOKIE_DAYS);
        updateGtag(prefs);
        showIcon();

        // Still check CCPA
        if (typeof api.saleOfDataRegion === 'function' && api.saleOfDataRegion()) {
          var ccpaBar = el('cc-ccpa-bar');
          if (ccpaBar) ccpaBar.classList.add('cc-visible');
        }
        return;
      }
    }

    // Fall back to first-party browser cookie
    var stored = getCookie(COOKIE_NAME);
    if (stored !== null) {
      updateGtag(stored);
      if (api && typeof api.setTrackingConsent === 'function') {
        updateShopifyPrivacy(stored);
      }
      showIcon();

      if (api && typeof api.saleOfDataRegion === 'function' && api.saleOfDataRegion()) {
        var ccpaBar = el('cc-ccpa-bar');
        if (ccpaBar) ccpaBar.classList.add('cc-visible');
      }
      return;
    }

    // Genuine first visit — show banner
    showBanner();

    if (api && typeof api.saleOfDataRegion === 'function' && api.saleOfDataRegion()) {
      var ccpaBar = el('cc-ccpa-bar');
      if (ccpaBar) {
        // Push banner up so CCPA bar is not hidden behind it
        var banner = el('cc-banner');
        if (banner) banner.style.bottom = '4rem';
        ccpaBar.classList.add('cc-visible');
      }
    }
  }

  // Load Shopify Customer Privacy API then initialise
  if (window.Shopify && typeof window.Shopify.loadFeatures === 'function') {
    window.Shopify.loadFeatures(
      [{ name: 'consent-tracking-api', version: '0.1' }],
      function (err) {
        if (err) console.warn('[cc] consent-tracking-api load error:', err);
        init();
      }
    );
  } else {
    // API not available — fall back to cookie-only path
    init();
  }
})();
</script>
