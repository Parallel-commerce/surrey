{%- if product.tags contains 'pre-order' -%}
  <div class="preorder-notification" role="note">
    <svg class="preorder-notification__icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="10"/>
      <line x1="12" y1="8" x2="12" y2="12"/>
      <line x1="12" y1="16" x2="12.01" y2="16"/>
    </svg>
    <p class="preorder-notification__text">
      <strong>This is a pre-order item.</strong> Once the item is available the product will be shipped.
    </p>
  </div>
{%- endif -%}
